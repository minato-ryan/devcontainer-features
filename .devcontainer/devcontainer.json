{
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "customizations": {
    "vscode": {
      "settings": {
        "json.schemas": [
          {
            "fileMatch": [
              "*/devcontainer-feature.json"
            ],
            "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
          }
        ]
      },
      "extensions": [
        "denoland.vscode-deno",
        "mads-hartmann.bash-ide-vscode",
        "EditorConfig.EditorConfig",
        "ms-vscode-remote.remote-containers",
        "anthropic.claude-code",
        "openai.chatgpt",
        "google.google-antigravity"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "toolsToInstall": "pre-commit"
    }
  },
  "remoteUser": "node",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/node/.local/bin"
  },
  "updateContentCommand": "npm install -g @devcontainers/cli rust-just",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends pipx shellcheck && pipx install 'pre-commit>=4.4,<5' && git config --global --add safe.directory \"$(pwd)\""
}
