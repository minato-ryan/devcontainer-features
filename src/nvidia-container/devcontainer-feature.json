{
    "id": "nvidia-container",
    "version": "1.0.0",
    "name": "NVIDIA Container Toolkit",
    "description": "Installs the NVIDIA Container Toolkit and configures container runtimes (such as Docker) for NVIDIA GPU support.",
    "documentationURL": "https://github.com/minato-ryan/devcontainer-features/tree/main/src/nvidia-container",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "1.20.1",
                "1.19.1"
            ],
            "default": "latest",
            "description": "Select or enter an NVIDIA Container Toolkit version (e.g. 'latest' or '1.20.1')."
        },
        "configureDocker": {
            "type": "boolean",
            "default": true,
            "description": "Register the nvidia runtime in /etc/docker/daemon.json."
        },
        "setAsDefault": {
            "type": "boolean",
            "default": false,
            "description": "Set nvidia as the default container runtime in Docker daemon."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/docker-in-docker",
        "ghcr.io/devcontainers/features/docker-outside-of-docker"
    ]
}
