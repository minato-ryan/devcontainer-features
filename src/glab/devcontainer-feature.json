{
    "id": "glab",
    "version": "1.0.0",
    "name": "GitLab CLI (glab)",
    "description": "Installs the GitLab CLI (glab), bringing GitLab to your terminal.",
    "documentationURL": "https://github.com/minato-ryan/devcontainer-features/tree/main/src/glab",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "1.120.0",
                "1.50.0"
            ],
            "default": "latest",
            "description": "Select or enter a glab version (e.g. 'latest' or '1.120.0')."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
